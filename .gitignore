# Bare name, not `node_modules/`: a worktree's dependencies are a SYMLINK back
# to the main checkout, and git reads a symlink as a file, so the trailing-slash
# form left it staged-able in every worktree.
node_modules
# Per-checkout Vite dep-optimizer cache (see vite.config.ts `cacheDir`). It
# cannot live in node_modules, because that symlink makes it shared.
.vite-cache
/dist/
# Generated terrain tile bake (tools/bake-terrain-tiles.mjs). Rebuilt
# automatically by the build's contract test when missing — never commit.
# Match the bare name too, so a worktree symlink at this path can't be staged.
public/data/terrain
.data/
# RL training artifacts: logs, frame recordings, checkpoints-in-progress.
# Deployed policies live in public/models/ and ARE committed.
rl/runs/
data/raw/
!data/raw/
data/raw/*
!data/raw/golf-presidio.json
!data/raw/golf-presidio-rels.json
data/city/
.DS_Store
*.blend1
*.mp4
scratchpad/
renders/
tmp/
# generation workspace (lives in the main repo checkout)
data/city

# API keys for asset-generation tooling (Tripo etc.)
.env

# Xcode user state (SF Companion)
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcshareddata/swiftpm/

ios/SFCompanion/build/
